# Which writer to use: offline | ollama | gemini | groq | openai_compatible
LLM_PROVIDER=offline
# Leave blank for the provider default (see src/ai_report/llm.py)
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_ATTEMPTS=3
# Seconds to wait for one answer before retrying
LLM_TIMEOUT_S=180
# Output budget per call, including a reasoning model's thinking
LLM_MAX_TOKENS=8192
# Reasoning models only (Groq gpt-oss): low | medium | high
LLM_REASONING_EFFORT=medium

# Ollama (local)
OLLAMA_HOST=http://localhost:11434

# Free-tier API keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Any OpenAI-compatible server (LM Studio, vLLM, llama.cpp, OpenRouter)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Report
REPORT_TITLE=Monthly Operations Report
COMPANY_LABEL=Sample Distribution Co. (anonymised)
CURRENCY_SYMBOL=$
ON_TIME_DAYS=5